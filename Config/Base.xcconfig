//
//  Base.xcconfig
//  Identifiers shared by every target. Placeholders only: copy
//  Local.xcconfig.example to Local.xcconfig (git-ignored) and set your own.
//

// Reverse-DNS prefix for every bundle ID (app, widget, tests).
BUNDLE_ID_PREFIX = com.example

// Apple Developer team used for signing.
DEVELOPMENT_TEAM =

// App Group shared by the app and the widget. Read at runtime from Info.plist.
APP_GROUP_IDENTIFIER = group.$(BUNDLE_ID_PREFIX).ClaudeUsage

// Local overrides last, so they win.
#include? "Local.xcconfig"
