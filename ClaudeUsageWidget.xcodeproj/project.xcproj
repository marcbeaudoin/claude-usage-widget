{
  "default-configuration": "Release",
  "configurations": [
    { "name": "Debug", "file": { "anchor": "Config", "relative-path": "Base.xcconfig" } },
    { "name": "Release", "file": { "anchor": "Config", "relative-path": "Base.xcconfig" } },
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    { "path": "ClaudeUsageWidgetsExtension.entitlements" },
    { "path": "README.md" },
    { "kind": "folder", "path": "Config" },
    { "path": "CLAUDE.md", "target-membership": [ "ClaudeUsageWidget/resources" ] },
    {
      "kind": "folder",
      "path": "ClaudeUsageWidget",
      "target-membership": [
        "ClaudeUsageWidget",
      ],
      "membership-exceptions": [
        {
          "target": "ClaudeUsageWidget",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "ClaudeUsageWidgetTests", "target-membership": [ "ClaudeUsageWidgetTests" ] },
    { "kind": "folder", "path": "ClaudeUsageWidgetUITests", "target-membership": [ "ClaudeUsageWidgetUITests" ] },
    {
      "kind": "folder",
      "path": "ClaudeUsageWidgets",
      "target-membership": [
        "ClaudeUsageWidgetsExtension",
      ],
      "membership-exceptions": [
        {
          "target": "ClaudeUsageWidgetsExtension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "/System/Library/Frameworks/WidgetKit.framework", "target-membership": [ "ClaudeUsageWidgetsExtension/frameworks" ] },
        { "path": "/System/Library/Frameworks/SwiftUI.framework", "target-membership": [ "ClaudeUsageWidgetsExtension/frameworks" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/ClaudeUsageWidget.app", "id": "49A67045308BA7BF001F82F9", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/ClaudeUsageWidgetTests.xctest", "id": "49A67052308BA7C1001F82F9", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/ClaudeUsageWidgetUITests.xctest", "id": "49A6705C308BA7C1001F82F9", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/ClaudeUsageWidgetsExtension.appex", "id": "497A1437308CC4CD00F5DCFB", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "ClaudeUsageWidget/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
      ],
    },
    { "kind": "folder", "path": "Shared", "target-membership": [ "ClaudeUsageWidget", "ClaudeUsageWidgetsExtension" ] },
    {
      "kind": "folder",
      "path": "Integration",
      "target-membership": [
        "ClaudeUsageWidget",
      ],
      "membership-exceptions": [
        {
          "target": "ClaudeUsageWidget",
          "exclusions": [
            "README.md",
            "fixtures/statusline-payload.sample.json",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "Scripts", "target-membership": [ "ClaudeUsageWidget" ] },
    { "kind": "folder", "path": "Tests" },
  ],
  "targets": [
    {
      "name": "ClaudeUsageWidget",
      "id": "49A67044308BA7BF001F82F9",
      "product": "Products/ClaudeUsageWidget.app",
      "product-type": "application",
      "dependencies": [
        "ClaudeUsageWidgetsExtension",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "ClaudeUsageWidget/ClaudeUsageWidget.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "COMBINE_HIDPI_IMAGES": "YES",
        "CURRENT_PROJECT_VERSION": "1",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_OUTGOING_NETWORK_CONNECTIONS": "YES",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_USER_SELECTED_FILES": "readonly",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "ClaudeUsageWidget/Info.plist",
        "INFOPLIST_KEY_LSUIElement": "YES",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "$(BUNDLE_ID_PREFIX).ClaudeUsageWidget",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "REGISTER_APP_GROUPS": "YES",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
      },
    }, {
      "name": "ClaudeUsageWidgetTests",
      "id": "49A67051308BA7C1001F82F9",
      "product": "Products/ClaudeUsageWidgetTests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "ClaudeUsageWidget",
      "dependencies": [
        "ClaudeUsageWidget",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "GENERATE_INFOPLIST_FILE": "YES",
        "MACOSX_DEPLOYMENT_TARGET": "27.0",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "$(BUNDLE_ID_PREFIX).ClaudeUsageWidgetTests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "STRING_CATALOG_GENERATE_SYMBOLS": "NO",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/ClaudeUsageWidget.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/ClaudeUsageWidget",
      },
    }, {
      "name": "ClaudeUsageWidgetUITests",
      "id": "49A6705B308BA7C1001F82F9",
      "product": "Products/ClaudeUsageWidgetUITests.xctest",
      "product-type": "bundle.ui-testing",
      "test-host-target": "ClaudeUsageWidget",
      "dependencies": [
        "ClaudeUsageWidget",
      ],
